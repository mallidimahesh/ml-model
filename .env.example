# ==============================================================================
# EcoSim Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your optional personal API keys.
# DO NOT commit your actual .env file with secrets to public repositories.
# ==============================================================================

# Federal Reserve Economic Data (FRED) API Key
# Sign up for a free FRED API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Note: EcoSim automatically connects to the official Federal Reserve direct data feed
# if this key is left blank, ensuring full functionality out-of-the-box.
FRED_API_KEY=your_fred_api_key_here

# World Bank Open Data API
# Note: World Bank API requires NO API key and works natively out-of-the-box.

# Application Server Settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
